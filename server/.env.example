# Bridgik Server Configuration
PORT=3001

# Admin Static IP addresses separated by comma.
# 127.0.0.1 and ::1 are included by default for local development.
# Add your external static IP here (e.g. ADMIN_IPS=127.0.0.1,::1,178.12.34.56)
ADMIN_IPS=127.0.0.1,::1,localhost

# Master Secret Key for emergency admin activation (?admin=YOUR_KEY)
ADMIN_SECRET_KEY=bridgik_creator_root_2026

# Yandex ID OAuth
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=bridgik_bot

# S3 Object Storage (Cloud.ru Evolution / AWS S3)
S3_ENDPOINT=https://s3.cloud.ru
S3_REGION=ru-central-1
S3_BUCKET=bridgik-drops
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
